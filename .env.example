# Copy to .env and adjust for your site. Never commit .env.

# Public URL (no trailing slash). Shown on the starter page and used at build time.
APP_URL=http://localhost:3000

# Host port nginx proxies to. Bind localhost only in docker-compose.yml.
APP_PORT=3000

# Port the Next.js process listens on inside the container (keep at 3000).
PORT=3000
